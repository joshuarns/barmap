{
  "name": "barmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && npm --prefix server run typecheck",
    "preview": "vite preview",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "create-admin": "npm --prefix server run create-admin --",
    "test": "vitest run --dir src && npm --prefix server test",
    "test:client": "vitest run --dir src",
    "build:all": "npm run build && npm --prefix server run build",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
