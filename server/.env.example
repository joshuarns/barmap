# PostgreSQL local: createdb barmap
DATABASE_URL=postgres://localhost:5432/barmap
DATABASE_SSL=false
PORT=4000
# Orígenes permitidos por CORS, separados por coma
CLIENT_ORIGIN=http://localhost:5173
# Obligatorio en producción (mín. 32 caracteres). Genera uno con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# URL pública del frontend (se usa en los enlaces de los correos)
APP_URL=http://localhost:5173
# Correo transaccional (Resend). Sin key, los correos se muestran en la consola del servidor.
RESEND_API_KEY=
MAIL_FROM=Barmap <onboarding@resend.dev>
# Imágenes: carpeta local en desarrollo. En producción se sustituye el adaptador por S3/R2 (lib/storage.ts).
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_URL=/uploads
MAX_UPLOAD_MB=8
# Proxies de confianza (para la IP real en límites de peticiones). 1 detrás de Render/Railway/Nginx.
TRUST_PROXY=1
# Frontend compilado (npm run build en la raíz). Si existe, este servidor sirve el sitio completo.
CLIENT_DIST=../dist
